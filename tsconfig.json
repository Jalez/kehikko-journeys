{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["bun", "vite/client"]
  },
  "include": [
    "page",
    "src",
    "wire",
    "test",
    "doors.ts",
    "limits.ts",
    "manifest.ts",
    "register.ts",
    "store.ts",
    "vite.config.ts"
  ]
}
